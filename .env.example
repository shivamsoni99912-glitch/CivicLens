# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public and safe to ship in the browser bundle; every table is
# protected by Row Level Security. NEVER put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
